# The Jira stub image: WireMock over the deterministic dataset in this directory (generated by sample-data/jira/generate.mjs from
# sample-data/plan/*.json; never hand-edit mappings/ or __files/). Build with THIS directory as the context, so the root .dockerignore
# (which keeps sample-data/ out of the app image's context) does not apply:
#
#   docker build -t astrolabe-jira-stub sample-data/jira-stub
#
# The tag AND digest equal the `wiremock` pin in gradle/libs.versions.toml (the in-JVM test fixture runs the same engine); move them
# together (.claude/docs/dependencies.md). Any Basic/Bearer Authorization header is accepted except the token `wrong-token`; switch the
# `jira-day2` scenario with: curl -X PUT http://localhost:8096/__admin/scenarios/jira-day2/state -d '{"state":"day2"}'
FROM wiremock/wiremock:3.13.2@sha256:0d4ecb3e4dc8213fd7a4d37d6a78f6e6b553a6d2e15bd51b0999781282ac61b3
COPY mappings /home/wiremock/mappings
COPY __files /home/wiremock/__files
CMD ["--disable-banner", "--max-request-journal-entries=1000"]
