# The Flow stub image: WireMock over the deterministic dataset in this directory (generated by sample-data/flow/generate.mjs from
# sample-data/plan/teams.json and the contract in sample-data/flow/contract.mjs; never hand-edit mappings/ or __files/). Build with THIS
# directory as the context, so the root .dockerignore (which keeps sample-data/ out of the app image's context) does not apply:
#
#   docker build -t astrolabe-flow-stub sample-data/flow-stub
#
# The tag AND digest equal the `wiremock` pin in gradle/libs.versions.toml AND the Jira stub's (sample-data/jira-stub/Dockerfile): one engine,
# three carriers; move them together (.claude/docs/dependencies.md). The only accepted credential is the stub service token in
# sample-data/flow/README.md; switch the `flow-day2` scenario with:
#   curl -X PUT http://localhost:8097/__admin/scenarios/flow-day2/state -d '{"state":"day2"}'
# and simulate an outage (both endpoints answer 500) with the `flow-outage` scenario, state `down`.
FROM wiremock/wiremock:3.13.2@sha256:0d4ecb3e4dc8213fd7a4d37d6a78f6e6b553a6d2e15bd51b0999781282ac61b3
# --chmod=a+rX: a checkout made under `umask 077` has 0600/0700 files, which the non-root user the stack runs this image as (uid 10001) could not read.
COPY --chmod=a+rX mappings /home/wiremock/mappings
COPY --chmod=a+rX __files /home/wiremock/__files
CMD ["--disable-banner", "--max-request-journal-entries=1000"]
