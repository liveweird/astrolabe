{
  "name": "astrolabe-e2e",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Browser blackbox E2E tests (Playwright) against a full stack the caller started and named (E2E_BASE_URL, E2E_MAILPIT_URL, E2E_JIRA_STUB_URL, E2E_FLOW_STUB_URL)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:setup": "node --test scripts/stack.test.ts && node --test scripts/flaky-summary.test.mjs",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "check:scenarios": "node scripts/check-scenarios.mjs",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
